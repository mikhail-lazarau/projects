{
  "name": "expense-tracker-root",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm --prefix frontend run lint:fix"
    ],
    "frontend/**/*.css": [
      "npm --prefix frontend run stylelint:fix"
    ],
    "backend/**/*.ts": [
      "npm --prefix backend run lint:fix"
    ],
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
